@namespace CollaborativeDrawing.Components
@using CollaborativeDrawing.Models
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Canvas> Logger
@implements IAsyncDisposable

<div class="drawing-container">
    <div class="toolbar">
        <div class="tool-group">
            <label>Цвет:</label>
            <input type="color" @bind="currentColor" @bind:event="oninput" />
        </div>
        <div class="tool-group">
            <label>Толщина:</label>
            <input type="range" min="1" max="20" @bind="lineWidth" />
            <span>@lineWidth</span>
        </div>
        <button class="btn btn-danger" @onclick="ClearCanvas">Очистить</button>
    </div>

    <div class="canvas-wrapper" @ref="canvasWrapper" @onmousemove="OnMouseMove" @onmouseleave="StopDrawing">
        <canvas @ref="canvas"
                @onmousedown="StartDrawing"
                @onmouseup="StopDrawing"
                @onmouseleave="StopDrawing"
                @ontouchstart="StartTouchDrawing"
                @ontouchmove="OnTouchMove"
                @ontouchend="StopDrawing"
                @ontouchcancel="StopDrawing">
        </canvas>

        @if (otherCursors != null)
        {
            @foreach (var cursor in otherCursors.Where(c => c != null))
            {
                <div class="remote-cursor"
                     style="left: @(cursor.X)px; top: @(cursor.Y)px; background-color: @cursor.Color;">
                    <span class="cursor-label" style="background-color: @cursor.Color;">
                        @cursor.UserName
                    </span>
                </div>
            }
        }
    </div>

    <div class="users-list">
        <h4>Участники (@(onlineUsers?.Count ?? 0))</h4>
        <ul>
            @if (onlineUsers != null)
            {
                @foreach (var user in onlineUsers)
                {
                    <li>
                        <span class="user-indicator" style="background-color: @user.Color"></span>
                        @user.UserName
                    </li>
                }
            }
        </ul>
    </div>
</div>

@code {
    private ElementReference canvas;
    private ElementReference canvasWrapper;
    private HubConnection? hubConnection;
    private bool isDrawing = false;
    private bool isConnected = false;
    private bool isDisposed = false;
    private bool isInitialized = false;
    private string currentColor = "#000000";
    private int lineWidth = 3;
    private List<DrawingPoint> drawingHistory = new();
    private List<CursorPosition> otherCursors = new();
    private List<dynamic> onlineUsers = new();
    private readonly SemaphoreSlim connectionLock = new SemaphoreSlim(1, 1);
    private CancellationTokenSource? cts;

    [Parameter] public string UserName { get; set; } = "Аноним";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isDisposed && !isInitialized)
        {
            try
            {
                cts = new CancellationTokenSource();
                isInitialized = true;
                
                // Даем время браузеру загрузить DOM
                await Task.Delay(100, cts.Token);
                
                if (!cts.Token.IsCancellationRequested)
                {
                    await InitializeCanvas();
                }
                
                if (!cts.Token.IsCancellationRequested)
                {
                    await InitializeSignalR();
                }
            }
            catch (OperationCanceledException)
            {
                // Компонент был размонтирован, игнорируем
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error during initialization");
            }
        }
    }

    private async Task InitializeCanvas()
    {
        try
        {
            if (isDisposed) return;
            
            // Проверяем, существует ли canvas элемент
            var exists = await JS.InvokeAsync<bool>("eval", "document.querySelector('canvas') !== null");
            if (!exists || isDisposed) return;
            
            await JS.InvokeVoidAsync("initializeCanvas", canvas);
            Logger.LogInformation("Canvas initialized");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Canvas initialization JS error (normal during disconnect)");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Canvas initialization error");
        }
    }

    private async Task InitializeSignalR()
    {
        try
        {
            if (isDisposed) return;

            hubConnection = new HubConnectionBuilder()
                .WithUrl(Navigation.ToAbsoluteUri("/drawinghub"))
                .WithAutomaticReconnect(new[] { 
                    TimeSpan.FromSeconds(0),
                    TimeSpan.FromSeconds(2),
                    TimeSpan.FromSeconds(5),
                    TimeSpan.FromSeconds(10)
                })
                .Build();

            hubConnection.On<DrawingPoint>("ReceiveDraw", async (point) =>
            {
                if (isDisposed) return;
                try
                {
                    if (!point.UserId.Equals(UserName, StringComparison.OrdinalIgnoreCase))
                    {
                        drawingHistory.Add(point);
                        await DrawOnCanvas(point);
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "ReceiveDraw error");
                }
            });

            hubConnection.On<CursorPosition>("UpdateCursor", (cursor) =>
            {
                if (isDisposed) return;
                try
                {
                    var existing = otherCursors.FirstOrDefault(c => c?.UserId == cursor.UserId);
                    if (existing != null)
                    {
                        existing.X = cursor.X;
                        existing.Y = cursor.Y;
                    }
                    else
                    {
                        otherCursors.Add(cursor);
                    }
                    
                    otherCursors.RemoveAll(c => c == null);
                    
                    InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "UpdateCursor error");
                }
            });

            hubConnection.On<List<DrawingPoint>>("LoadDrawingHistory", async (history) =>
            {
                if (isDisposed) return;
                try
                {
                    drawingHistory = history ?? new List<DrawingPoint>();
                    await RedrawCanvas();
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "LoadDrawingHistory error");
                }
            });

            hubConnection.On<List<dynamic>>("UpdateUsersList", (users) =>
            {
                if (isDisposed) return;
                try
                {
                    onlineUsers = users ?? new List<dynamic>();
                    InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "UpdateUsersList error");
                }
            });

            hubConnection.On("CanvasCleared", async () =>
            {
                if (isDisposed) return;
                try
                {
                    drawingHistory.Clear();
                    await ClearLocalCanvas();
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "CanvasCleared error");
                }
            });

            hubConnection.On<string>("UserDisconnected", (userId) =>
            {
                if (isDisposed) return;
                try
                {
                    otherCursors.RemoveAll(c => c?.UserId == userId);
                    InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "UserDisconnected error");
                }
            });

            hubConnection.Closed += async (error) =>
            {
                isConnected = false;
                Logger.LogDebug($"Connection closed: {error?.Message}");
                await InvokeAsync(StateHasChanged);
            };

            hubConnection.Reconnecting += (error) =>
            {
                isConnected = false;
                Logger.LogDebug($"Reconnecting: {error?.Message}");
                return Task.CompletedTask;
            };

            hubConnection.Reconnected += (connectionId) =>
            {
                isConnected = true;
                Logger.LogDebug($"Reconnected as {connectionId}");
                return Task.CompletedTask;
            };

            await ConnectWithRetryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SignalR initialization error");
        }
    }

    private async Task ConnectWithRetryAsync(int maxRetries = 5)
    {
        for (int i = 0; i < maxRetries && !isDisposed; i++)
        {
            try
            {
                await hubConnection!.StartAsync();
                isConnected = true;
                Logger.LogInformation($"Connected to SignalR hub");
                return;
            }
            catch (Exception ex) when (!isDisposed)
            {
                Logger.LogDebug($"Connection attempt {i + 1} failed: {ex.Message}");
                if (i == maxRetries - 1) return;
                await Task.Delay(TimeSpan.FromSeconds(Math.Pow(2, i)));
            }
            catch
            {
                // Компонент размонтирован, выходим
                return;
            }
        }
    }

    private async Task DrawOnCanvas(DrawingPoint point)
    {
        if (isDisposed) return;
        try
        {
            await JS.InvokeVoidAsync("drawPoint", canvas, point);
        }
        catch (JSException ex)
        {
            Logger.LogDebug(ex, "DrawOnCanvas JS error");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "DrawOnCanvas error");
        }
    }

    private async void StartDrawing(MouseEventArgs e)
    {
        if (isDisposed) return;
        isDrawing = true;
        await Draw((int)e.ClientX, (int)e.ClientY, true);
    }

    private async void StartTouchDrawing(TouchEventArgs e)
    {
        if (isDisposed) return;
        try
        {
            //e.PreventDefault();
            isDrawing = true;
            var touch = e.Touches[0];
            await Draw((int)touch.ClientX, (int)touch.ClientY, true);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "StartTouchDrawing error");
        }
    }

    private async void OnMouseMove(MouseEventArgs e)
    {
        if (isDisposed) return;
        try
        {
            await UpdateCursorPosition((int)e.ClientX, (int)e.ClientY);
            
            if (isDrawing)
            {
                await Draw((int)e.ClientX, (int)e.ClientY, false);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "OnMouseMove error");
        }
    }

    private async void OnTouchMove(TouchEventArgs e)
    {
        if (isDisposed) return;
        try
        {
            //e.PreventDefault();
            var touch = e.Touches[0];
            await UpdateCursorPosition((int)touch.ClientX, (int)touch.ClientY);
            
            if (isDrawing)
            {
                await Draw((int)touch.ClientX, (int)touch.ClientY, false);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "OnTouchMove error");
        }
    }

    private void StopDrawing()
    {
        if (isDisposed) return;
        isDrawing = false;
    }

    private async Task Draw(int clientX, int clientY, bool isStartOfStroke)
    {
        if (isDisposed) return;
        try
        {
            var canvasRect = await JS.InvokeAsync<CanvasRect>("getCanvasRect", canvas);
            var relativeX = clientX - canvasRect.Left;
            var relativeY = clientY - canvasRect.Top;

            if (relativeX >= 0 && relativeX <= canvasRect.Width && 
                relativeY >= 0 && relativeY <= canvasRect.Height)
            {
                var point = new DrawingPoint
                {
                    X = (int)relativeX,
                    Y = (int)relativeY,
                    Color = currentColor,
                    LineWidth = lineWidth,
                    IsStartOfStroke = isStartOfStroke,
                    UserId = UserName
                };

                if (!isStartOfStroke)
                {
                    drawingHistory.Add(point);
                }
                
                await DrawOnCanvas(point);

                if (isConnected && hubConnection?.State == HubConnectionState.Connected && !isDisposed)
                {
                    await hubConnection.SendAsync("Draw", point);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Draw error");
        }
    }

    private async Task UpdateCursorPosition(int x, int y)
    {
        if (isDisposed) return;
        try
        {
            if (isConnected && hubConnection?.State == HubConnectionState.Connected && !isDisposed)
            {
                await hubConnection.SendAsync("UpdateCursor", x, y);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "UpdateCursorPosition error");
        }
    }

    private async Task ClearCanvas()
    {
        if (isDisposed) return;
        try
        {
            if (isConnected && hubConnection?.State == HubConnectionState.Connected && !isDisposed)
            {
                await hubConnection.SendAsync("ClearCanvas");
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "ClearCanvas error");
        }
    }

    private async Task RedrawCanvas()
    {
        if (isDisposed) return;
        try
        {
            await ClearLocalCanvas();
            foreach (var point in drawingHistory)
            {
                if (isDisposed) return;
                await DrawOnCanvas(point);
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "RedrawCanvas error");
        }
    }

    private async Task ClearLocalCanvas()
    {
        if (isDisposed) return;
        try
        {
            await JS.InvokeVoidAsync("clearCanvas", canvas);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "ClearLocalCanvas error");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (isDisposed) return;
        
        Logger.LogInformation("Disposing Canvas component");
        isDisposed = true;
        isConnected = false;
        
        cts?.Cancel();
        cts?.Dispose();
        
        try
        {
            if (hubConnection != null)
            {
                await hubConnection.DisposeAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Dispose error");
        }
        
        connectionLock.Dispose();
    }

    private class CanvasRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }
}